# PropAgent AI: Backend Environment Variables Template
# Copy this file to .env and fill in your values.

# Running Mode
# Set to true to bypass OpenAI client initialization and use local simulated dialog models.
# Set to false to connect real GPT-4o-mini dialogue parsing.
DEMO_MODE=true

# Optional OpenAI API Credentials (required only if DEMO_MODE=false)
OPENAI_API_KEY=your_openai_api_key_here

# Network Server Configuration
PORT=8000
HOST=127.0.0.1

# Production Security
# List of origins permitted to fetch api content, split by comma.
CORS_ORIGIN=*
